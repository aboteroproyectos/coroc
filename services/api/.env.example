# Copie este archivo como .env.local para docker compose, o exporte las variables en su plataforma.
# Secretos: genérelos con `openssl rand -base64 48` (JWT) y `openssl rand -base64 32` (clave de datos AES-256).
COROC_JWT_SECRET=cambie-este-secreto-por-uno-de-48-bytes-aleatorios-en-base64
COROC_DATA_KEY=cambie-por-32-bytes-aleatorios-en-base64=
# Dirección pública de la app (enlaces de recuperación y verificación de recibos).
COROC_PUBLIC_URL=http://localhost:3000
# Orígenes web permitidos (portal del deudor en fases siguientes), separados por comas.
COROC_CORS_ORIGINS=
# hibp (recomendado; consulta con k-anonimato) o local (sin internet).
COROC_BREACHED_CHECK=hibp
# optional solo en desarrollo: en producción el segundo factor es obligatorio para el Propietario (§7.1).
COROC_MFA_OWNER=required
LOG_LEVEL=info
